# Copy this file to .env.local and fill in your own keys.
# NEVER commit .env.local. It is already listed in .gitignore.

# Your personal Qloo hackathon key (from the Qloo hackathon form)
QLOO_API_KEY=

# Hackathon keys only work against the hackathon API
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ---- AI providers (tried in this order: Claude, Groq, Cerebras, Gemini) ----

# Claude (main). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
# Model for the final market brief and city ideas (use claude-sonnet-5-5 for higher quality)
ANTHROPIC_MODEL=claude-haiku-5-5
# Model for the small, fast steps
ANTHROPIC_FAST_MODEL=claude-haiku-5-5

# The providers below are optional backups. Leave them empty to use only Claude.

# Groq (optional backup): https://console.groq.com/keys
GROQ_API_KEY=
# Check the model names available to you at https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Cerebras (optional backup): https://cloud.cerebras.ai
# Check the model names available to you in the Cerebras console and set them here.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b
CEREBRAS_FAST_MODEL=

# Gemini (optional): last backup if Groq and Cerebras both fail. https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.0-flash
GEMINI_FAST_MODEL=
GEMINI_FALLBACK_MODEL=

# Optional: UN Comtrade key (free) for official import data per country.
# Sign up at https://comtradedeveloper.un.org, subscribe to the free "comtrade - v1" product, and copy the primary key.
COMTRADE_API_KEY=

# Optional: set to "true" to use sample data instead of real APIs (for testing the UI)
MOCK_MODE=false
